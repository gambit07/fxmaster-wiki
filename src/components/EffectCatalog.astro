---
import reference from '../data/reference.json';
import { withBase } from '../utils/links';
import { modulePackageName, modulePackagePage } from '../data/module-links.mjs';

type PackageFilter = 'all' | 'core' | 'plus';
type KindFilter = 'all' | 'particle' | 'filter';

interface Props {
  packageName?: PackageFilter;
  kind?: KindFilter;
  group?: string | string[];
  interactive?: boolean;
  compact?: boolean;
  limit?: number;
  ids?: string[];
}

const {
  packageName = 'all',
  kind = 'all',
  group,
  interactive = true,
  compact = false,
  limit,
  ids,
} = Astro.props;

const groupFilter = group ? new Set(Array.isArray(group) ? group : [group]) : null;
const idOrder = ids ? new Map(ids.map((id, index) => [id, index])) : null;
const displayLabel = (effect: (typeof reference.effects)[number]) => effect.label;
const filteredEffects = reference.effects
  .filter((effect) => !idOrder || idOrder.has(effect.id))
  .filter((effect) => packageName === 'all' || effect.package === packageName)
  .filter((effect) => kind === 'all' || effect.kind === kind)
  .filter((effect) => !groupFilter || groupFilter.has(effect.group))
  .sort((a, b) => idOrder
    ? Number(idOrder.get(a.id)) - Number(idOrder.get(b.id))
    : displayLabel(a).localeCompare(displayLabel(b)));
const visibleEffects = Number.isFinite(limit) ? filteredEffects.slice(0, Math.max(0, Number(limit))) : filteredEffects;
const instanceId = `fxm-effect-catalog-${Math.random().toString(36).slice(2, 9)}`;
const showPackageFilter = interactive && packageName === 'all';
const showKindFilter = interactive && kind === 'all';

const effectHref = (effect: (typeof reference.effects)[number]) =>
  withBase(`/reference/effects/details/${effect.id}/`);
const titleCase = (value: string) => value.replace(/(^|[-_])([a-z])/g, (_match, separator, letter) => `${separator ? ' ' : ''}${letter.toUpperCase()}`);
const groupLabel = (value: string) => value === 'creatures' ? 'Animals' : titleCase(value);
const kindMark = (effectKind: string) => (effectKind === 'particle' ? '✦' : '◈');
---

<section
  id={instanceId}
  class:list={['fxm-catalog', compact && 'fxm-catalog--compact']}
  data-fxm-effect-catalog
  data-initial-count={visibleEffects.length}
>
  {interactive && (
    <div class="fxm-catalog-controls" role="search" aria-label="Filter the effect catalog">
      <label class="fxm-catalog-search">
        <span>Search effects</span>
        <input type="search" placeholder="Rain, wind, token trails…" autocomplete="off" data-fxm-effect-search />
      </label>
      {showPackageFilter && (
        <label>
          <span>Package</span>
          <select data-fxm-package-filter>
            <option value="all">All packages</option>
            <option value="core">FXMaster</option>
            <option value="plus">FXMaster+</option>
          </select>
        </label>
      )}
      {showKindFilter && (
        <label>
          <span>Type</span>
          <select data-fxm-kind-filter>
            <option value="all">Particles and filters</option>
            <option value="particle">Particle effects</option>
            <option value="filter">Filter effects</option>
          </select>
        </label>
      )}
    </div>
  )}

  {interactive && (
    <p class="fxm-catalog-count" aria-live="polite" data-fxm-effect-count>
      Showing {visibleEffects.length} {visibleEffects.length === 1 ? 'effect' : 'effects'}
    </p>
  )}

  <div class="fxm-effect-grid">
    {visibleEffects.map((effect) => (
      <article
        class="fxm-effect-card"
        data-fxm-effect-card
        data-package={effect.package}
        data-kind={effect.kind}
        data-search={`${displayLabel(effect)} ${effect.id} ${effect.package} ${effect.kind} ${effect.group} ${groupLabel(effect.group)} ${effect.description}`.toLowerCase()}
      >
        <div class="fxm-effect-card__top">
          <span class="fxm-effect-mark" data-kind={effect.kind} aria-hidden="true">{kindMark(effect.kind)}</span>
          <a
            class="fxm-badge"
            data-tier={effect.package}
            href={modulePackagePage(effect.package)}
            target="_blank"
            rel="noreferrer"
            title={`Open ${modulePackageName(effect.package)} on Foundry VTT`}
          >
            {effect.package === 'plus' ? 'FXMaster+' : 'FXMaster'}
          </a>
          <span class="fxm-badge" data-kind={effect.kind}>{titleCase(effect.kind)}</span>
        </div>
        <a class="fxm-effect-card__link" href={effectHref(effect)} aria-label={`Open ${displayLabel(effect)} reference`}>
          <h3>{displayLabel(effect)}</h3>
          <p>{effect.description}</p>
          <div class="fxm-effect-card__footer">
            <span>{groupLabel(effect.group)}</span>
            <span>{effect.parameterCount} parameters</span>
          </div>
        </a>
      </article>
    ))}
  </div>

  {visibleEffects.length === 0 && <p class="fxm-empty-state">No effects match this section.</p>}
  {interactive && <p class="fxm-empty-state" hidden data-fxm-effect-empty>No effects match those filters.</p>}
</section>

<script>
  const normalizeCatalogValue = (value: unknown): string => String(value ?? '').trim().toLowerCase();

  function initializeEffectCatalog(catalog: HTMLElement): void {
    if (catalog.dataset.fxmReady === 'true') return;
    catalog.dataset.fxmReady = 'true';

    const search = catalog.querySelector<HTMLInputElement>('[data-fxm-effect-search]');
    const packageFilter = catalog.querySelector<HTMLSelectElement>('[data-fxm-package-filter]');
    const kindFilter = catalog.querySelector<HTMLSelectElement>('[data-fxm-kind-filter]');
    const cards = [...catalog.querySelectorAll<HTMLElement>('[data-fxm-effect-card]')];
    const count = catalog.querySelector<HTMLElement>('[data-fxm-effect-count]');
    const empty = catalog.querySelector<HTMLElement>('[data-fxm-effect-empty]');

    const refresh = (): void => {
      const query = normalizeCatalogValue(search?.value);
      const packageValue = normalizeCatalogValue(packageFilter?.value || 'all');
      const kindValue = normalizeCatalogValue(kindFilter?.value || 'all');
      let visible = 0;

      for (const card of cards) {
        const matchesSearch = !query || normalizeCatalogValue(card.dataset.search).includes(query);
        const matchesPackage = packageValue === 'all' || card.dataset.package === packageValue;
        const matchesKind = kindValue === 'all' || card.dataset.kind === kindValue;
        const show = matchesSearch && matchesPackage && matchesKind;
        card.hidden = !show;
        if (show) visible += 1;
      }

      if (count) count.textContent = `Showing ${visible} ${visible === 1 ? 'effect' : 'effects'}`;
      if (empty) empty.hidden = visible !== 0;
    };

    search?.addEventListener('input', refresh);
    packageFilter?.addEventListener('change', refresh);
    kindFilter?.addEventListener('change', refresh);
    refresh();
  }

  const initializeEffectCatalogs = (): void => {
    document.querySelectorAll<HTMLElement>('[data-fxm-effect-catalog]').forEach(initializeEffectCatalog);
  };

  initializeEffectCatalogs();
  document.addEventListener('astro:page-load', initializeEffectCatalogs);
</script>
